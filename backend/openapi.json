  "components": {
    "schemas": {
      "Action": {
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Version"
          },
          "action": {
            "type": "string",
            "enum": [
              "submit",
              "resubmit",
              "withdraw",
              "start-review",
              "request-revision",
              "accept",
              "reject"
            ],
            "title": "Action"
          },
          "note": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "synthetic_acknowledged": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Synthetic Acknowledged"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "version",
          "action"
        ],
        "title": "Action"
      },
      "Assignment": {
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Version"
          },
          "reviewer_id": {
            "type": "string",
            "maxLength": 36,
            "minLength": 1,
            "title": "Reviewer Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "version",
          "reviewer_id"
        ],
        "title": "Assignment"
      },
      "Credentials": {
        "properties": {
          "username": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_]{3,24}$",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "Credentials"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LabInput": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "benchmark",
              "verification"
            ],
            "title": "Kind"
          },
          "fixture": {
            "type": "string",
            "enum": [
              "personal-json",
              "identity-png",
              "document-pdf",
              "video-mp4"
            ],
            "title": "Fixture"
          },
          "repetitions": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 30.0,
            "title": "Repetitions",
            "default": 30
          },
          "warmups": {
            "type": "integer",
            "const": 2,
            "title": "Warmups",
            "default": 2
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind",
          "fixture"
        ],
        "title": "LabInput"
      },
      "Model": {
        "properties": {},
        "additionalProperties": false,
        "type": "object",
        "title": "Model"
      },
      "Profile": {
        "properties": {
          "full_name": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Full Name"
          },
          "identity_number": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Identity Number"
          },
          "date_of_birth": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Date Of Birth"
          },
          "email": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Email"
          },
          "phone": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Phone"
          },
          "address": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Address"
          },
          "occupation": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Occupation"
          },
          "account_purpose": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Account Purpose"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "full_name",
          "identity_number",
          "date_of_birth",
          "email",
          "phone",
          "address",
          "occupation",
          "account_purpose"
        ],
        "title": "Profile"
      },
      "Registration": {
        "properties": {
          "username": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_]{3,24}$",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "Registration"
      },
      "SaveProfile": {
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Version"
          },
          "profile": {
            "$ref": "#/components/schemas/Profile"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "version",
          "profile"
        ],
        "title": "SaveProfile"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}