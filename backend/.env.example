# Generate a fresh secret with python setup_env.py. Do not commit real secrets.
VELTRIX_MASTER_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
# SQLite is the local default; MySQL configuration:
# DATABASE_URL=mysql+pymysql://veltrix:YOUR_PASSWORD@127.0.0.1:3306/veltrix?charset=utf8mb4
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
