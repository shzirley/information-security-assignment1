# Generated locally by python setup_env.py. Never replace existing keys.
VELTRIX_KEK_V1_BASE64=GENERATE_LOCALLY
VELTRIX_AUTH_SECRET_BASE64=GENERATE_SEPARATELY
APP_ENV=demo
# Default: persistent SQLite database at backend/data/bankkyc.db
# Optional MySQL (create database and user first; do not reuse the legacy vault DB):
# KYC_DATABASE_URL=mysql+pymysql://veltrix_app:YOUR_PASSWORD@127.0.0.1:3306/veltrix_kyc?charset=utf8mb4
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
