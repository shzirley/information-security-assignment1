# Copy to .env.cloud in the project root (ignored by Git).
# Use the same cloud values as Render. Never copy backend/.env over this file.
APP_ENV=production
COOKIE_SECURE=true
KYC_DATABASE_URL=mysql://USER:URL_ENCODED_PASSWORD@HOST:PORT/defaultdb
ALLOWED_ORIGINS=https://YOUR-PROJECT.vercel.app
# Copy both generated values from Render. Keep them when redeploying.
VELTRIX_KEK_V1_BASE64=RENDER_GENERATED_VALUE
VELTRIX_AUTH_SECRET_BASE64=RENDER_GENERATED_DIFFERENT_VALUE
# Paste the full Aiven CA certificate inside the quotes, with actual newlines.
KYC_MYSQL_CA_PEM="-----BEGIN CERTIFICATE-----
REPLACE_WITH_AIVEN_CA_CERTIFICATE
-----END CERTIFICATE-----"
